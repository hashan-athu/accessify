generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Scan {
  id           String   @id @default(cuid())
  url          String
  status       ScanStatus @default(PENDING)
  score        Int?
  issues       Int?
  requestedAt  DateTime
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum ScanStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
